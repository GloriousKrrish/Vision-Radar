# VisionRadar Environment Configuration Example
# Copy this file to .env and configure with your server-side keys
# DO NOT COMMIT THE ACTUAL .env FILE

# Gemini Multimodal Intelligence Service
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true
GEMINI_MAX_SELECTED_FRAMES=6
GEMINI_REQUEST_TIMEOUT_SEC=30
GEMINI_MAX_RETRIES=2
